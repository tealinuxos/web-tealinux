# ============================================
# .env for Traefik-based Deployment
# ============================================
# Copy this file to .env on the VPS and fill in the real values
# DO NOT commit this file to git!

# ============================================
# Database Configuration
# ============================================
DB_NAME=tealinux
DB_USER=tealinux_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_DISINI

# ============================================
# OAuth - Google
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=https://tealinuxos.org/api/auth/google/callback

# ============================================
# OAuth - GitHub
# ============================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=https://tealinuxos.org/api/auth/github/callback

# ============================================
# JWT Secret (generate with: openssl rand -base64 64)
# ============================================
JWT_SECRET=GANTI_DENGAN_SECRET_RANDOM_DISINI

# ============================================
# Domain Configuration
# ============================================
DOMAIN=tealinuxos.org
