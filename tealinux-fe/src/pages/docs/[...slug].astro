---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import DocNavigation from '../../components/DocNavigation.astro';

export const prerender = true;

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  // Filter out index since it's handled by index.astro
  return docs
    .filter(entry => entry.id !== 'index')
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;

// Check if entry exists before rendering
if (!entry) {
  return Astro.redirect('/docs');
}

const { Content, headings } = await render(entry);
---

<DocsLayout frontmatter={entry.data}>
  <article class="prose prose-invert">
    <Content />
  </article>
  
  <DocNavigation currentId={entry.id} />
</DocsLayout>
