---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/organisms/Navbar.astro';
import EditionCard from '../components/molecules/EditionCard.astro';
import Footer from '../components/organisms/Footer.astro';

export const prerender = true;
---

<Layout title="Download TeaLinuxOS - Choose Your Edition">
	<main class="min-h-screen bg-transparent text-slate-50 font-sans flow-root relative overflow-hidden">
		<div class="relative z-[1]">
			<Navbar />

			<header class="relative py-[80px] px-[5%] pt-40 text-center mx-auto overflow-hidden">
				<!-- Green glow background -->
				<div class="absolute -top-[20%] -left-[10%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-[radial-gradient(circle,rgba(84,205,76,0.18)_0%,transparent_70%)] blur-[80px] pointer-events-none z-0"></div>
				<div class="absolute top-[10%] -right-[5%] w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[radial-gradient(circle,rgba(84,205,76,0.08)_0%,transparent_70%)] blur-[80px] pointer-events-none z-0"></div>

				<div class="relative z-[1] max-w-[900px] mx-auto">
					<div class="flex justify-center mb-6">
						<div class="w-16 h-16 flex items-center justify-center">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#54CD4C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
							</svg>
						</div>
					</div>

					<h1 class="text-4xl md:text-6xl font-black mb-6 text-[#54CD4C]">
						Download TeaLinuxOS
					</h1>
					<p class="text-lg text-white font-medium max-w-2xl mx-auto opacity-90">
						Choose your edition and experience the delight of an open-source creation
					</p>
				</div>
			</header>

			<section class="relative py-12 px-[5%] max-w-[1200px] mx-auto">
				<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(84,205,76,0.15)_0%,transparent_70%)] pointer-events-none -z-10"></div>

				<div class="flex flex-col md:flex-row gap-8  justify-center items-center">
					<!-- COSMIC EDITION -->
				<EditionCard class="group w-full max-w-[460px] !p-0 !border-white/5 !bg-[#0a0a0a] overflow-hidden hover:!border-[#54CD4C]/30 hover:shadow-[0_0_50px_rgba(84,205,76,0.1)] transition-all duration-500 relative flex flex-col">
					<!-- Thumbnail Image Container -->
					<div class="relative w-full h-[220px] overflow-hidden">
						<img src="/img/cosmic-thumbnail-converted-from-png.webp" alt="COSMIC Desktop" class="w-full h-full object-cover" />
						<div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent opacity-60"></div>
						<!-- Glassmorphism Badge -->
						<div class="absolute top-4 left-4 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20">
							<div class="flex items-center gap-2">
								<div class="w-1.5 h-1.5 rounded-full bg-[#54CD4C] shadow-[0_0_8px_#54CD4C]"></div>
								<span class="text-white text-[10px] font-bold uppercase tracking-[0.2em]">COSMIC EDITION</span>
							</div>
						</div>
					</div>

					<!-- Card Content -->
					<div class="p-8 space-y-8 flex-1 flex flex-col pt-4">
						<!-- Features List -->
						<div class="relative space-y-6">
							<!-- Subtle vertical line for timeline feel -->
							<div class="absolute left-[11px] top-2 bottom-2 w-px bg-gradient-to-b from-[#54CD4C]/40 via-[#54CD4C]/10 to-transparent"></div>

							<div class="relative pl-8 group/item">
								<div class="absolute left-0 top-1 w-[22px] h-[22px] rounded-full bg-[#0a0a0a] border-2 border-[#54CD4C] flex items-center justify-center transition-transform group-hover/item:scale-110">
									<svg class="w-3 h-3 text-[#54CD4C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
								</div>
								<div class="flex flex-col">
									<h4 class="font-bold text-white text-base mb-1 tracking-tight">Latest Release</h4>
									<p class="text-sm text-slate-400 leading-relaxed group-hover/item:text-slate-300 transition-colors">The newest version featuring the innovative COSMIC desktop environment.</p>
								</div>
							</div>

							<div class="relative pl-8 group/item">
								<div class="absolute left-0 top-1 w-[22px] h-[22px] rounded-full bg-[#0a0a0a] border-2 border-[#54CD4C] flex items-center justify-center transition-transform group-hover/item:scale-110">
									<svg class="w-3 h-3 text-[#54CD4C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
								</div>
								<div class="flex flex-col">
									<h4 class="font-bold text-white text-base mb-1 tracking-tight">Wayland by Default</h4>
									<p class="text-sm text-slate-400 leading-relaxed group-hover/item:text-slate-300 transition-colors">Experience a modern and secure display server protocol for smoother graphics.</p>
								</div>
							</div>

							<div class="relative pl-8 group/item">
								<div class="absolute left-0 top-1 w-[22px] h-[22px] rounded-full bg-[#0a0a0a] border-2 border-[#54CD4C] flex items-center justify-center transition-transform group-hover/item:scale-110">
									<svg class="w-3 h-3 text-[#54CD4C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
								</div>
								<div class="flex flex-col">
									<h4 class="font-bold text-white text-base mb-1 tracking-tight">Enhanced Performance</h4>
									<p class="text-sm text-slate-400 leading-relaxed group-hover/item:text-slate-300 transition-colors">Optimized for speed and efficiency on a wide range of hardware.</p>
								</div>
							</div>
						</div>

						<!-- Premium Download Button -->
						<div class="mt-auto">
							<a href="/download/cosmic" class="download-btn relative overflow-hidden flex h-[56px] w-full justify-center items-center gap-3 rounded-2xl bg-[#54CD4C] group/btn transition-all duration-300 hover:shadow-[0_0_30px_rgba(84,205,76,0.5)] active:scale-95 no-underline" data-edition="COSMIC" data-download-url="/download/cosmic">
								<!-- Shimmer effect overlay -->
								<div class="absolute inset-0 w-1/2 h-full bg-white/20 -skew-x-[45deg] -translate-x-full group-hover/btn:animate-[shimmer_1s_ease-in-out]"></div>
								
								<div class="w-6 h-6 flex items-center justify-center bg-black/10 rounded-lg group-hover/btn:bg-black/20 transition-colors">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
										<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
										<polyline points="7 10 12 15 17 10"></polyline>
										<line x1="12" y1="15" x2="12" y2="3"></line>
									</svg>
								</div>
								<span class="relative text-black text-sm font-black tracking-tight">GET COSMIC</span>
							</a>
						</div>
					</div>
				</EditionCard>

				<!-- PLASMA EDITION -->
				<EditionCard class="group w-full max-w-[460px] !p-0 !border-white/5 !bg-[#0a0a0a] overflow-hidden hover:!border-[#54CD4C]/30 hover:shadow-[0_0_50px_rgba(84,205,76,0.1)] transition-all duration-500 relative flex flex-col">
					<!-- Thumbnail Image Container -->
					<div class="relative w-full h-[220px] overflow-hidden">
						<img src="/img/kde-thumbail-converted-from-png.webp" alt="KDE Plasma Desktop" class="w-full h-full object-cover" />
						<div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent opacity-60"></div>
						<!-- Glassmorphism Badge -->
						<div class="absolute top-4 left-4 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20">
							<div class="flex items-center gap-2">
								<div class="w-1.5 h-1.5 rounded-full bg-[#54CD4C] shadow-[0_0_8px_#54CD4C]"></div>
								<span class="text-white text-[10px] font-bold uppercase tracking-[0.2em]">PLASMA EDITION</span>
							</div>
						</div>
					</div>

					<!-- Card Content -->
					<div class="p-8 space-y-8 flex-1 flex flex-col pt-4">
						<!-- Features List -->
						<div class="relative space-y-6">
							<!-- Subtle vertical line for timeline feel -->
							<div class="absolute left-[11px] top-2 bottom-2 w-px bg-gradient-to-b from-[#54CD4C]/40 via-[#54CD4C]/10 to-transparent"></div>

							<div class="relative pl-8 group/item">
								<div class="absolute left-0 top-1 w-[22px] h-[22px] rounded-full bg-[#0a0a0a] border-2 border-[#54CD4C] flex items-center justify-center transition-transform group-hover/item:scale-110">
									<svg class="w-3 h-3 text-[#54CD4C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
								</div>
								<div class="flex flex-col">
									<h4 class="font-bold text-white text-base mb-1 tracking-tight">Stable & Powerful</h4>
									<p class="text-sm text-slate-400 leading-relaxed group-hover/item:text-slate-300 transition-colors">Featuring the highly customizable and feature-rich KDE Plasma desktop.</p>
								</div>
							</div>

							<div class="relative pl-8 group/item">
								<div class="absolute left-0 top-1 w-[22px] h-[22px] rounded-full bg-[#0a0a0a] border-2 border-[#54CD4C] flex items-center justify-center transition-transform group-hover/item:scale-110">
									<svg class="w-3 h-3 text-[#54CD4C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
								</div>
								<div class="flex flex-col">
									<h4 class="font-bold text-white text-base mb-1 tracking-tight">Extensive Tooling</h4>
									<p class="text-sm text-slate-400 leading-relaxed group-hover/item:text-slate-300 transition-colors">Comes packed with a suite of powerful applications for all your needs.</p>
								</div>
							</div>

							<div class="relative pl-8 group/item">
								<div class="absolute left-0 top-1 w-[22px] h-[22px] rounded-full bg-[#0a0a0a] border-2 border-[#54CD4C] flex items-center justify-center transition-transform group-hover/item:scale-110">
									<svg class="w-3 h-3 text-[#54CD4C]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
								</div>
								<div class="flex flex-col">
									<h4 class="font-bold text-white text-base mb-1 tracking-tight">Community Favorite</h4>
									<p class="text-sm text-slate-400 leading-relaxed group-hover/item:text-slate-300 transition-colors">A beloved choice for users who want control and a beautiful interface.</p>
								</div>
							</div>
						</div>

						<!-- Premium Download Button -->
						<div class="mt-auto">
							<a href="/download/plasma" class="download-btn relative overflow-hidden flex h-[56px] w-full justify-center items-center gap-3 rounded-2xl bg-[#54CD4C] group/btn transition-all duration-300 hover:shadow-[0_0_30px_rgba(84,205,76,0.5)] active:scale-95 no-underline" data-edition="PLASMA" data-download-url="/download/plasma">
								<!-- Shimmer effect overlay -->
								<div class="absolute inset-0 w-1/2 h-full bg-white/20 -skew-x-[45deg] -translate-x-full group-hover/btn:animate-[shimmer_1s_ease-in-out]"></div>
								
								<div class="w-6 h-6 flex items-center justify-center bg-black/10 rounded-lg group-hover/btn:bg-black/20 transition-colors">
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
										<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
										<polyline points="7 10 12 15 17 10"></polyline>
										<line x1="12" y1="15" x2="12" y2="3"></line>
									</svg>
								</div>
								<span class="relative text-black text-sm font-black tracking-tight">GET PLASMA</span>
							</a>
						</div>
					</div>
				</EditionCard>
				</div>
			</section>

			<!-- How to Install Section -->
			<section class="relative py-12 px-[5%] flex flex-col items-center">
				<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(84,205,76,0.15)_0%,transparent_70%)] pointer-events-none -z-10"></div>
			<h2 class="text-3xl md:text-4xl font-bold p-2 text-white mb-3">
				How to Install
				<span class="inline-block relative">
				<svg class="absolute inset-0 w-full h-full" viewBox="0 0 159 32" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
					<path d="M8.08859 2.75138C8.62801 1.10969 10.1607 0 11.8887 0H154.27C156.899 0 158.813 2.49208 158.135 5.03172L151.728 29.0317C151.261 30.7822 149.675 32 147.863 32H4.00301C1.28 32 -0.647121 29.3383 0.202877 26.7514L8.08859 2.75138Z" fill="#54CD4C"/>
				</svg>
				<span class="relative z-10 px-4 py-1 text-black font-bold">TeaLinux </span>
				</span>
			</h2>

				<EditionCard class="w-full max-w-[918px] min-h-[186px] !p-0 flex-row justify-between items-center bg-white/5 backdrop-blur-xl border border-white/10 overflow-hidden hidden md:flex hover:!border-white/10 hover:!shadow-none hover:!scale-100 transition-none">
					<!-- Step 1 -->
					<div class="flex-1 h-full flex flex-col justify-center items-center text-center p-6 border-r border-white/10 relative">
						<div class="w-12 h-12 rounded-full bg-[#54CD4C] flex items-center justify-center mb-4 text-black shadow-[0_0_15px_rgba(84,205,76,0.4)]">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
						</div>
						<h3 class="text-white font-bold mb-2">1. Create Bootable Media</h3>
						<p class="text-xs text-slate-300 leading-relaxed max-w-[200px]">
							Create a bootable USB drive using your favorite tool, such as Etcher
						</p>
					</div>

					<!-- Step 2 -->
					<div class="flex-1 h-full flex flex-col justify-center items-center text-center p-6 border-r border-white/10 relative">
						<div class="w-12 h-12 rounded-full bg-[#54CD4C] flex items-center justify-center mb-4 text-black shadow-[0_0_15px_rgba(84,205,76,0.4)]">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
						</div>
						<h3 class="text-white font-bold mb-2">2. Boot into Live Session</h3>
						<p class="text-xs text-slate-300 leading-relaxed max-w-[200px]">
							Try TeaLinuxOS without installing it to your system
						</p>
					</div>

					<!-- Step 3 -->
					<div class="flex-1 h-full flex flex-col justify-center items-center text-center p-6 relative">
						<div class="w-12 h-12 rounded-full bg-[#54CD4C] flex items-center justify-center mb-4 text-black shadow-[0_0_15px_rgba(84,205,76,0.4)]">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
						</div>
						<h3 class="text-white font-bold mb-2">3. Install to Disk</h3>
						<p class="text-xs text-slate-300 leading-relaxed max-w-[200px]">
							Follow the guided installer to set up TeaLinuxOS
						</p>
					</div>
				</EditionCard>

				<!-- Mobile Version (Vertical Stack) -->
				<div class="flex flex-col gap-4 w-full md:hidden">
					<EditionCard class="w-full p-6 flex flex-col items-center text-center">
						<div class="w-12 h-12 rounded-full bg-[#54CD4C] flex items-center justify-center mb-4 text-black">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
						</div>
						<h3 class="text-white font-bold mb-2">1. Create Bootable Media</h3>
						<p class="text-sm text-slate-300">Use Rufus or Balena Etcher to create a bootable USB drive</p>
					</EditionCard>
					<EditionCard class="w-full p-6 flex flex-col items-center text-center">
						<div class="w-12 h-12 rounded-full bg-[#54CD4C] flex items-center justify-center mb-4 text-black">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
						</div>
						<h3 class="text-white font-bold mb-2">2. Boot into Live Session</h3>
						<p class="text-sm text-slate-300">Try TeaLinuxOS without installing it to your system</p>
					</EditionCard>
					<EditionCard class="w-full p-6 flex flex-col items-center text-center">
						<div class="w-12 h-12 rounded-full bg-[#54CD4C] flex items-center justify-center mb-4 text-black">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
						</div>
						<h3 class="text-white font-bold mb-2">3. Install to Disk</h3>
						<p class="text-sm text-slate-300">Follow the guided installer to set up TeaLinuxOS</p>
					</EditionCard>
				</div>

				<a href="/docs/getting-started/installation" class="mt-10 flex items-center gap-3 px-6 py-3 rounded-full bg-white text-black font-bold hover:bg-slate-200 transition-all group">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
					View Full Installation Guide
				</a>
			</section>

			<!-- Support The Project Section -->
			<section class="relative py-24 px-[5%] flex flex-col items-center text-center">
				<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(84,205,76,0.15)_0%,transparent_70%)] pointer-events-none -z-10"></div>
				<h2 class="text-3xl md:text-4xl font-bold text-[#54CD4C] mb-4">
					Support The Project
				</h2>
				<p class="text-slate-300 text-lg max-w-2xl mb-10">
					Help us improve TeaLinuxOS by contributing to our open-source community.
				</p>

				<div class="flex flex-col sm:flex-row gap-6 w-full justify-center">
					<a href="https://github.com/tealinuxos" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-white text-black font-bold hover:bg-slate-200 transition-all">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
						Contribute On GitHub
					</a>
					<a href="#" class="flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-[#54CD4C] text-black font-bold hover:bg-[#45b83f] transition-all">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
						Join Our Community
					</a>
				</div>
			</section>

			<Footer />
		</div>
	</main>

	<style is:global>
		@keyframes shimmer {
			0% { transform: skewX(-45deg) translateX(-150%); }
			100% { transform: skewX(-45deg) translateX(250%); }
		}
	</style>

	<script>
		import { trackDownload } from '../lib/api';

		// Handle download button clicks
		document.querySelectorAll('.download-btn').forEach(btn => {
			btn.addEventListener('click', async (e) => {
				const target = e.currentTarget as HTMLButtonElement;
				const edition = target.dataset.edition;
				const downloadUrl = target.dataset.downloadUrl;

				if (!edition) return;

				// Show loading state
				target.disabled = true;
				const originalText = target.querySelector('span')?.textContent;
				const span = target.querySelector('span');
				if (span) span.textContent = 'Starting download...';

				try {
					// Track the download
					await trackDownload(edition);
					console.log(`Download tracked: ${edition}`);
				} catch (error) {
					console.error('Failed to track download:', error);
					// Continue with download even if tracking fails
				}

				// Restore button state
				target.disabled = false;
				if (span && originalText) span.textContent = originalText;

				// Redirect to download (placeholder - replace with actual ISO URLs)
				if (downloadUrl && downloadUrl !== '#') {
					window.location.href = downloadUrl;
				} else {
					alert(`Thank you for downloading TeaLinuxOS ${edition}! The download will start shortly.`);
				}
			});
		});
	</script>
</Layout>
