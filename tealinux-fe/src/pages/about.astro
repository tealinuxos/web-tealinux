---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/organisms/Navbar.astro';
import Footer from '../components/organisms/Footer.astro';

export const prerender = true;
---

<Layout title="About TeaLinuxOS - Our Story">
	<main class="min-h-screen bg-transparent text-slate-50 font-sans flow-root relative overflow-hidden">

		<div class="relative z-[1]">
			<Navbar />

			<header class="relative pt-32 md:pt-40 pb-16 md:pb-24 px-4 md:px-[5%] overflow-hidden">
				<!-- Background Glows -->
				<div class="absolute -top-[20%] -left-[10%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-[radial-gradient(circle,rgba(84,205,76,0.18)_0%,transparent_70%)] blur-[80px] pointer-events-none z-0"></div>
				<div class="absolute top-[10%] -right-[5%] w-[40vw] h-[40vw] max-w-[500px] max-h-[500px] bg-[radial-gradient(circle,rgba(84,205,76,0.08)_0%,transparent_70%)] blur-[80px] pointer-events-none z-0"></div>

				<!-- Glowing Title -->
				<div class="relative z-[1] text-center mb-12 md:mb-16">
					<h1 class="hero-title text-[clamp(2.5rem,6vw,4.5rem)] font-black text-white leading-[1.05] tracking-tight">
						Tea<span class="text-[#54CD4C]">Linux</span>OS
					</h1>
					<div class="w-24 h-[3px] bg-gradient-to-r from-transparent via-[#54CD4C] to-transparent mx-auto mt-4"></div>
				</div>

				<!-- Split Layout: Logo Left + Info Cards Right -->
				<div class="relative z-[1] flex flex-col lg:flex-row items-center justify-center gap-10 lg:gap-16 max-w-[1100px] mx-auto">

					<!-- Left: Logo -->
					<div class="flex-shrink-0 flex items-center justify-center">
						<div class="relative w-[260px] h-[260px] md:w-[340px] md:h-[340px]">
							<img src="/img/logo-gede-about.webp" alt="TeaLinuxOS Logo" class="w-full h-auto" />
						</div>
					</div>

					<!-- Right: Stacked Info Cards -->
					<div class="flex-1 max-w-[480px] flex flex-col gap-4">
						<!-- Community Badge -->
						<div class="info-card group relative rounded-[20px] border-[3px] border-[#C5EBA7] bg-[linear-gradient(116deg,rgba(255,255,255,0.40)_2.89%,rgba(255,255,255,0.10)_69.08%)] backdrop-blur-[20px] p-5 transition-all duration-300 hover:border-[#54CD4C] hover:shadow-[0_0_25px_rgba(84,205,76,0.6)] hover:scale-[1.02] overflow-hidden">
							<span class="text-[#54CD4C] text-[11px] font-bold uppercase tracking-[0.15em] mb-2 block">Community</span>
							<p class="text-white text-lg md:text-xl font-bold leading-tight">
								Dinus Open Source Community
							</p>
							<p class="text-slate-400 text-sm mt-1">(DOSCOM) — University of Dian Nuswantoro</p>
						</div>

						<!-- Codename Block -->
						<div class="info-card group relative rounded-[20px] border-[3px] border-[#C5EBA7] bg-[linear-gradient(116deg,rgba(255,255,255,0.40)_2.89%,rgba(255,255,255,0.10)_69.08%)] backdrop-blur-[20px] p-5 transition-all duration-300 hover:border-[#54CD4C] hover:shadow-[0_0_25px_rgba(84,205,76,0.6)] hover:scale-[1.02] overflow-hidden">
							<span class="text-[#54CD4C] text-[11px] font-bold uppercase tracking-[0.15em] mb-2 block">Codename</span>
							<div class="flex items-baseline gap-3">
								<span class="text-white text-2xl md:text-3xl font-black tracking-tight">Celia</span>
								<span class="text-slate-500 text-sm">v14.0</span>
							</div>
							<p class="text-slate-400 text-sm mt-2">The latest release of TeaLinuxOS, built on Arch Linux with modern desktop environments.</p>
						</div>

						<!-- Philosophy Block -->
						<div class="info-card group relative rounded-[20px] border-[3px] border-[#54CD4C]/40 bg-[linear-gradient(116deg,rgba(84,205,76,0.15)_2.89%,rgba(84,205,76,0.05)_69.08%)] backdrop-blur-[20px] p-5 transition-all duration-300 hover:border-[#54CD4C] hover:shadow-[0_0_25px_rgba(84,205,76,0.6)] hover:scale-[1.02] overflow-hidden">
							<span class="text-[#54CD4C] text-[11px] font-bold uppercase tracking-[0.15em] mb-3 block">Philosophy</span>
							<p class="text-[#54CD4C] text-xl md:text-2xl font-bold italic leading-snug">
								"Nikmatnya Sebuah Racikan"
							</p>
							<p class="text-slate-400 text-sm mt-2">The delight of a perfect brew — crafted with passion, served with purpose.</p>
						</div>
					</div>
				</div>
			</header>

			<section class="relative py-20 md:py-28 px-4 md:px-[5%] overflow-hidden">
				<!-- Animated Gradient Wave Background -->
				<div class="absolute inset-0 overflow-hidden pointer-events-none">
					<div class="gradient-wave absolute -bottom-[50%] left-0 w-[200%] h-[100%] bg-[radial-gradient(ellipse_at_center,rgba(84,205,76,0.08)_0%,transparent_60%)] blur-[60px]"></div>
				</div>
				<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(84,205,76,0.12)_0%,transparent_70%)] pointer-events-none"></div>

				<div class="relative z-[1] max-w-[900px] mx-auto">
					<!-- Section Title -->
					<div class="text-center mb-14 md:mb-20">
						<h2 class="section-glow-title text-3xl md:text-5xl font-black text-white leading-tight">
							Basis <span class="text-[#54CD4C]">Distribusi</span>
						</h2>
						<p class="text-slate-400 text-sm md:text-base mt-3 max-w-lg mx-auto">
							The evolution of TeaLinuxOS through the years
						</p>
					</div>

					<!-- Version History Timeline -->
				<div class="relative max-w-[1000px] mx-auto">
					<!-- Center Vertical Line -->
					<div class="absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-[3px] bg-gradient-to-b from-transparent via-[#54CD4C]/40 to-transparent hidden md:block shadow-[0_0_10px_rgba(84,205,76,0.3)]"></div>

					<div class="space-y-6 md:space-y-8">
						<!-- v1.0 - LEFT -->
						<div class="timeline-item flex justify-center md:justify-end items-center opacity-30">
							<div class="timeline-card md:w-[calc(50%-40px)] md:mr-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/50 font-mono text-sm block">TeaLinuxOS ver 1.0</span>
								<span class="text-slate-600 text-xs">Codename: —</span>
								<p class="text-slate-600 text-xs mt-0.5">Based on Ubuntu</p>
							</div>
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/20 border border-white/10 hidden md:block"></div>
						</div>

						<!-- v2.0 - RIGHT -->
						<div class="timeline-item flex justify-center md:justify-start items-center opacity-30">
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/20 border border-white/10 hidden md:block"></div>
							<div class="timeline-card md:w-[calc(50%-40px)] md:ml-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/50 font-mono text-sm block">TeaLinuxOS ver 2.0</span>
								<span class="text-slate-600 text-xs">Codename: Cameilia</span>
								<p class="text-slate-600 text-xs mt-0.5">Based on Ubuntu</p>
							</div>
						</div>

						<!-- v3.0 - LEFT -->
						<div class="timeline-item flex justify-center md:justify-end items-center opacity-35">
							<div class="timeline-card md:w-[calc(50%-40px)] md:mr-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/50 font-mono text-sm block">TeaLinuxOS ver 3.0</span>
								<span class="text-slate-600 text-xs">Codename: Jaasmine</span>
								<p class="text-slate-600 text-xs mt-0.5">Based on Ubuntu</p>
							</div>
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/20 border border-white/10 hidden md:block"></div>
						</div>

						<!-- v4.0 - RIGHT -->
						<div class="timeline-item flex justify-center md:justify-start items-center opacity-35">
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/20 border border-white/10 hidden md:block"></div>
							<div class="timeline-card md:w-[calc(50%-40px)] md:ml-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/50 font-mono text-sm block">TeaLinuxOS ver 4.0</span>
								<span class="text-slate-600 text-xs">Codename: Rosemary</span>
								<p class="text-slate-600 text-xs mt-0.5">Based on Ubuntu</p>
							</div>
						</div>

						<!-- v5.0 - LEFT -->
						<div class="timeline-item flex justify-center md:justify-end items-center opacity-40">
							<div class="timeline-card md:w-[calc(50%-40px)] md:mr-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/50 font-mono text-sm block">TeaLinuxOS ver 5.0</span>
								<span class="text-slate-600 text-xs">Codename: Edelweiss</span>
								<p class="text-slate-600 text-xs mt-0.5">Based on Ubuntu</p>
							</div>
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/20 border border-white/10 hidden md:block"></div>
						</div>

						<!-- v6.0 - RIGHT -->
						<div class="timeline-item flex justify-center md:justify-start items-center opacity-40">
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/20 border border-white/10 hidden md:block"></div>
							<div class="timeline-card md:w-[calc(50%-40px)] md:ml-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/50 font-mono text-sm block">TeaLinuxOS ver 6.0</span>
								<span class="text-slate-600 text-xs">Codename: Jasmine</span>
								<p class="text-slate-600 text-xs mt-0.5">Based on Ubuntu</p>
							</div>
						</div>

						<!-- v7.0 - LEFT -->
						<div class="timeline-item flex justify-center md:justify-end items-center opacity-45">
							<div class="timeline-card md:w-[calc(50%-40px)] md:mr-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/60 font-mono text-sm block">TeaLinuxOS ver 7.0</span>
								<span class="text-slate-500 text-xs">Codename: Pappermint</span>
								<p class="text-slate-600 text-xs mt-0.5">Based on Ubuntu</p>
							</div>
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/25 border border-white/15 hidden md:block"></div>
						</div>

						<!-- v8.0 - RIGHT -->
						<div class="timeline-item flex justify-center md:justify-start items-center opacity-50">
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/30 border border-white/20 hidden md:block"></div>
							<div class="timeline-card md:w-[calc(50%-40px)] md:ml-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/60 font-mono text-sm block">TeaLinuxOS ver 8.0</span>
								<span class="text-slate-500 text-xs">Codename: Rose</span>
								<p class="text-slate-500 text-xs mt-0.5">Based on Linux Mint</p>
							</div>
						</div>

						<!-- v9.0 - LEFT -->
						<div class="timeline-item flex justify-center md:justify-end items-center opacity-55">
							<div class="timeline-card md:w-[calc(50%-40px)] md:mr-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/70 font-mono text-sm block">TeaLinuxOS ver 9.0</span>
								<span class="text-slate-500 text-xs">Codename: Jolly</span>
								<p class="text-slate-500 text-xs mt-0.5">Based on Lubuntu</p>
							</div>
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/30 border border-white/20 hidden md:block"></div>
						</div>

						<!-- v10.0 - RIGHT -->
						<div class="timeline-item flex justify-center md:justify-start items-center opacity-60">
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/35 border border-white/20 hidden md:block"></div>
							<div class="timeline-card md:w-[calc(50%-40px)] md:ml-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/70 font-mono text-sm block">TeaLinuxOS ver 10.0</span>
								<span class="text-slate-500 text-xs">Codename: Cinnamon</span>
								<p class="text-slate-500 text-xs mt-0.5">Based on Lubuntu</p>
							</div>
						</div>

						<!-- v11.0 - LEFT -->
						<div class="timeline-item flex justify-center md:justify-end items-center opacity-65">
							<div class="timeline-card md:w-[calc(50%-40px)] md:mr-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/75 font-mono text-sm block">TeaLinuxOS ver 11.0</span>
								<span class="text-slate-400 text-xs">Codename: Celia</span>
								<p class="text-slate-500 text-xs mt-0.5">Based on Lubuntu</p>
							</div>
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/40 border border-white/25 hidden md:block"></div>
						</div>

						<!-- v12.0 - RIGHT -->
						<div class="timeline-item flex justify-center md:justify-start items-center opacity-75">
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-white/50 border border-white/30 hidden md:block"></div>
							<div class="timeline-card md:w-[calc(50%-40px)] md:ml-[40px] w-full max-w-[400px] p-4 rounded-xl border border-white/5 bg-white/[0.02] backdrop-blur-sm">
								<span class="text-white/80 font-mono text-sm block">TeaLinuxOS ver 12.0</span>
								<span class="text-slate-400 text-xs">Codename: Chamomile</span>
								<p class="text-slate-400 text-xs mt-0.5">Based on Ubuntu</p>
							</div>
						</div>

						<!-- v13.0 - LEFT -->
						<div class="timeline-item flex justify-center md:justify-end items-center opacity-85">
							<div class="timeline-card md:w-[calc(50%-40px)] md:mr-[40px] w-full max-w-[400px] p-4 rounded-xl border border-[#54CD4C]/10 bg-white/[0.03] backdrop-blur-sm">
								<span class="text-white/90 font-mono text-sm block">TeaLinuxOS ver 13.0</span>
								<span class="text-slate-300 text-xs">Codename: Chrysanth</span>
								<p class="text-slate-400 text-xs mt-0.5">Based on Arch Linux</p>
							</div>
							<div class="absolute left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-[#54CD4C]/50 border border-[#54CD4C]/30 hidden md:block shadow-[0_0_8px_rgba(84,205,76,0.4)]"></div>
						</div>

						<!-- v14.0 - LATEST - RIGHT (Highlighted) -->
						<div class="timeline-item flex justify-center md:justify-start items-center">
							<div class="absolute left-1/2 -translate-x-1/2 w-4 h-4 md:w-5 md:h-5 rounded-full bg-[#54CD4C] hidden md:block latest-dot shadow-[0_0_20px_rgba(84,205,76,0.7)]"></div>
							<div class="timeline-card-latest md:w-[calc(50%-40px)] md:ml-[40px] w-full max-w-[400px] p-5 rounded-xl border-2 border-[#54CD4C]/30 bg-[#54CD4C]/[0.06] backdrop-blur-md shadow-[0_8px_30px_rgba(84,205,76,0.15)]">
								<div class="flex items-center gap-2 flex-wrap mb-1">
									<span class="text-[#54CD4C] font-mono text-base md:text-lg font-bold">TeaLinuxOS ver 14.0</span>
									<span class="px-2 py-0.5 rounded-full bg-[#54CD4C]/25 text-[#54CD4C] text-[10px] font-bold uppercase tracking-wider">Latest</span>
								</div>
								<span class="text-[#54CD4C]/90 text-sm font-semibold block">Codename: Celia</span>
								<p class="text-[#54CD4C]/70 text-sm mt-0.5 font-medium">Based on Arch Linux</p>
							</div>
						</div>
					</div>
				</div>
				</div>
			</section>

			<section class="relative py-20 md:py-28 px-4 md:px-[5%] overflow-hidden">
				<!-- Background Glow -->
				<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(84,205,76,0.1)_0%,transparent_70%)] pointer-events-none"></div>

				<div class="relative z-[1] max-w-[1100px] mx-auto">
					<!-- Section Title -->
					<div class="text-center mb-14 md:mb-20">
						<h2 class="section-glow-title text-3xl md:text-5xl font-black text-white leading-tight">
							Mengapa <span class="text-[#54CD4C]">TeaLinux</span>?
						</h2>
						<p class="text-slate-400 text-sm md:text-base mt-3 max-w-lg mx-auto">
							The reasons why TeaLinuxOS is perfect for you
						</p>
					</div>

					<!-- Split Layout -->
					<div class="flex flex-col items-center justify-center">
						<!-- Left: Numbered Benefit Points -->
						<div class="flex flex-col gap-4 max-w-[550px] w-full mx-auto">
							<!-- Benefit 1 -->
							<div class="benefit-chip group flex items-center gap-4 p-4 rounded-2xl border border-white/[0.07] bg-white/[0.03] backdrop-blur-sm transition-all duration-300 hover:border-[#54CD4C]/30 hover:bg-[#54CD4C]/[0.05] hover:translate-x-1">
								<div class="flex-shrink-0 w-10 h-10 rounded-xl bg-[#54CD4C]/15 border border-[#54CD4C]/25 flex items-center justify-center text-[#54CD4C] font-black text-sm shadow-[0_0_10px_rgba(84,205,76,0.15)]">
									01
								</div>
								<div>
									<h3 class="text-white font-bold text-sm md:text-base">Comfort</h3>
									<p class="text-slate-400 text-xs md:text-sm mt-0.5">Designed to feel familiar and easy, like your favorite brew.</p>
								</div>
							</div>

							<!-- Benefit 2 -->
							<div class="benefit-chip group flex items-center gap-4 p-4 rounded-2xl border border-white/[0.07] bg-white/[0.03] backdrop-blur-sm transition-all duration-300 hover:border-[#54CD4C]/30 hover:bg-[#54CD4C]/[0.05] hover:translate-x-1">
								<div class="flex-shrink-0 w-10 h-10 rounded-xl bg-[#54CD4C]/15 border border-[#54CD4C]/25 flex items-center justify-center text-[#54CD4C] font-black text-sm shadow-[0_0_10px_rgba(84,205,76,0.15)]">
									02
								</div>
								<div>
									<h3 class="text-white font-bold text-sm md:text-base">Easy Installation</h3>
									<p class="text-slate-400 text-xs md:text-sm mt-0.5">A guided installer that makes setup effortless, even for beginners.</p>
								</div>
							</div>

							<!-- Benefit 3 -->
							<div class="benefit-chip group flex items-center gap-4 p-4 rounded-2xl border border-white/[0.07] bg-white/[0.03] backdrop-blur-sm transition-all duration-300 hover:border-[#54CD4C]/30 hover:bg-[#54CD4C]/[0.05] hover:translate-x-1">
								<div class="flex-shrink-0 w-10 h-10 rounded-xl bg-[#54CD4C]/15 border border-[#54CD4C]/25 flex items-center justify-center text-[#54CD4C] font-black text-sm shadow-[0_0_10px_rgba(84,205,76,0.15)]">
									03
								</div>
								<div>
									<h3 class="text-white font-bold text-sm md:text-base">Complete Documentation</h3>
									<p class="text-slate-400 text-xs md:text-sm mt-0.5">Comprehensive guides and docs to help you every step of the way.</p>
								</div>
							</div>

							<!-- Benefit 4 -->
							<div class="benefit-chip group flex items-center gap-4 p-4 rounded-2xl border border-white/[0.07] bg-white/[0.03] backdrop-blur-sm transition-all duration-300 hover:border-[#54CD4C]/30 hover:bg-[#54CD4C]/[0.05] hover:translate-x-1">
								<div class="flex-shrink-0 w-10 h-10 rounded-xl bg-[#54CD4C]/15 border border-[#54CD4C]/25 flex items-center justify-center text-[#54CD4C] font-black text-sm shadow-[0_0_10px_rgba(84,205,76,0.15)]">
									04
								</div>
								<div>
									<h3 class="text-white font-bold text-sm md:text-base">Beginner-Friendly</h3>
									<p class="text-slate-400 text-xs md:text-sm mt-0.5">Perfect for students and newcomers exploring the Linux world.</p>
								</div>
							</div>

							<!-- Benefit 5 -->
							<div class="benefit-chip group flex items-center gap-4 p-4 rounded-2xl border border-white/[0.07] bg-white/[0.03] backdrop-blur-sm transition-all duration-300 hover:border-[#54CD4C]/30 hover:bg-[#54CD4C]/[0.05] hover:translate-x-1">
								<div class="flex-shrink-0 w-10 h-10 rounded-xl bg-[#54CD4C]/15 border border-[#54CD4C]/25 flex items-center justify-center text-[#54CD4C] font-black text-sm shadow-[0_0_10px_rgba(84,205,76,0.15)]">
									05
								</div>
								<div>
									<h3 class="text-white font-bold text-sm md:text-base">What You Need Is What You Get</h3>
									<p class="text-slate-400 text-xs md:text-sm mt-0.5">Pre-configured with essential tools — nothing more, nothing less.</p>
								</div>
							</div>
						</div>

						<!-- Right: Circular Glowing Logo Card -->
				
					</div>
				</div>
			</section>

