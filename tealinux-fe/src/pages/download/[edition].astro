---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/organisms/Navbar.astro';
import Footer from '../../components/organisms/Footer.astro';
import EditionCard from '../../components/molecules/EditionCard.astro';
import EditionScreenshot from '../../components/molecules/EditionScreenshot.astro';
import EditionSpecRow from '../../components/molecules/EditionSpecRow.astro';
import RequirementItem from '../../components/molecules/RequirementItem.astro';

const editions: Record<string, {
  name: string;
  codename: string;
  basedOn: string;
  kernelVersion: string;
  releaseDate: string;
  desktopEnvironment: string;
  size: string;
  downloadUrl: string;
  screenshot: string;
  displayServer: string;
  features: string[];
}> = {
  cosmic: {
    name: 'TeaLinux COSMIC',
    codename: 'Celia',
    basedOn: 'Arch Linux',
    kernelVersion: '6.25.2',
    releaseDate: '2025-06-14',
    desktopEnvironment: 'COSMIC',
    size: '~1.9 GiB',
    downloadUrl: 'https://pinguin.dinus.ac.id/iso/tealinuxos/TeaLinuxOS-Arch/2025/release/tealinux-celia-cosmic-2025.10.24-x86_64.iso',
    screenshot: '/img/cosmic_copy.webp',
    displayServer: 'Wayland',
    features: ['Wayland by default', 'Clean COSMIC desktop', 'Fast performance', 'Modern tiling support'],
  },
  plasma: {
    name: 'TeaLinux Plasma',
    codename: 'Celia',
    basedOn: 'Arch Linux',
    kernelVersion: '6.25.2',
    releaseDate: '2025-06-14',
    desktopEnvironment: 'KDE Plasma 6',
    size: '~2.0 GiB',
    downloadUrl: 'https://pinguin.dinus.ac.id/iso/tealinuxos/TeaLinuxOS-Arch/2025/release/tealinux-celia-plasma-2025.10.24-x86_64.iso',
    screenshot: '/img/kde1_copy.webp',
    displayServer: 'X11 / Wayland',
    features: ['KDE Plasma 6', 'Full customization support', 'Beautiful, user-friendly interface', 'Extensive widget ecosystem'],
  },
};

export function getStaticPaths() {
  return [
    { params: { edition: 'cosmic' } },
    { params: { edition: 'plasma' } },
  ];
}

const { edition } = Astro.params;
const data = editions[edition!];

if (!data) {
  return Astro.redirect('/download');
}
---

<Layout title={`Download ${data.name} - TeaLinuxOS`}>
  <main class="min-h-screen bg-transparent text-slate-50 font-sans flow-root relative overflow-hidden">
    <div class="relative z-[1]">
      <Navbar />

      <!-- Edition Detail Section -->
      <section class="relative py-12 px-[5%] pt-40 max-w-[1100px] mx-auto">
        <EditionCard class="!max-w-full !min-h-0 !p-0 !gap-0">
          <!-- Main Layout: Screenshot + Info -->
          <div class="flex flex-col md:flex-row gap-10 md:gap-12 p-6 md:p-10">
            <!-- Screenshot Side -->
            <EditionScreenshot screenshot={data.screenshot} name={data.name} />

            <!-- Info Side -->
            <div class="flex-1 min-w-0 flex flex-col gap-6">
              <!-- Header -->
              <div class="flex flex-col gap-3">
                <h1 class="text-[24px] font-semibold m-0">
                  <span class="inline-block relative">
                    <svg class="absolute inset-0 w-full h-full" viewBox="0 0 159 32" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                      <path d="M8.08859 2.75138C8.62801 1.10969 10.1607 0 11.8887 0H154.27C156.899 0 158.813 2.49208 158.135 5.03172L151.728 29.0317C151.261 30.7822 149.675 32 147.863 32H4.00301C1.28 32 -0.647121 29.3383 0.202877 26.7514L8.08859 2.75138Z" fill="#54CD4C"/>
                    </svg>
                    <span class="relative z-10 px-4 py-1 text-black font-bold">{edition!.toUpperCase()}</span>
                  </span>
                  <span class="text-white ml-1">Edition</span>
                </h1>
                <span class="inline-block w-fit px-3.5 py-1 rounded-full bg-[#54CD4C]/15 text-[#54CD4C] text-xs font-semibold tracking-wider border border-[#54CD4C]/30">
                  {data.displayServer}
                </span>
              </div>

              <!-- Specs -->
              <div class="flex flex-col gap-3">
                <EditionSpecRow label="Name" value={data.name} />
                <EditionSpecRow label="Codename" value={data.codename} />
                <EditionSpecRow label="Based On" value={data.basedOn} />
                <EditionSpecRow label="Kernel Version" value={data.kernelVersion} />
                <EditionSpecRow label="Release Date" value={data.releaseDate} />
                <EditionSpecRow label="Desktop Environment" value={data.desktopEnvironment} />
                <EditionSpecRow label="Size" value={data.size} />
              </div>
            </div>
          </div>

          <!-- Separator -->
          <div class="h-px bg-gradient-to-r from-transparent via-white/10 to-transparent mx-6 md:mx-10"></div>

          <!-- Download Button -->
          <div class="flex flex-col items-center gap-4 px-6 md:px-10 pt-8 pb-6 md:pb-10">
            <button
              id="download-btn"
              data-edition={edition!.toUpperCase()}
              data-download-url={data.downloadUrl}
              class="flex items-center justify-center gap-2.5 py-3.5 px-10 min-w-[240px] rounded-full bg-[#54CD4C] text-black text-[15px] font-bold border-none cursor-pointer transition-all duration-300 hover:bg-[#45b83f] hover:shadow-[0_0_30px_rgba(84,205,76,0.4)] hover:-translate-y-0.5 active:translate-y-0 disabled:opacity-60 disabled:cursor-not-allowed disabled:transform-none"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span>Direct Download</span>
            </button>
            <p class="text-xs text-slate-500 m-0">
              File: tealinux-celia-{edition}-x86_64.iso • {data.size}
            </p>
          </div>
        </EditionCard>
      </section>

      <!-- System Requirements Section -->
      <section class="relative py-12 px-[5%] max-w-[1100px] mx-auto">
        <EditionCard class="!max-w-full !min-h-0">
          <h2 class="text-xl font-bold text-white mb-6 m-0">System Requirements</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <RequirementItem label="Processor" value="x86_64 compatible (64-bit)">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#54CD4C" stroke-width="2"><rect x="4" y="4" width="16" height="12" rx="2" /><line x1="2" y1="20" x2="22" y2="20" /></svg>
            </RequirementItem>
            <RequirementItem label="RAM" value="Minimum 2 GB (4 GB recommended)">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#54CD4C" stroke-width="2"><path d="M6 19v-8a6 6 0 0112 0v8" /><rect x="4" y="19" width="16" height="2" rx="1" /></svg>
            </RequirementItem>
            <RequirementItem label="Storage" value="Minimum 20 GB free disk space">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#54CD4C" stroke-width="2"><circle cx="12" cy="12" r="10" /><path d="M8 14s1.5 2 4 2 4-2 4-2" /><line x1="9" y1="9" x2="9.01" y2="9" /><line x1="15" y1="9" x2="15.01" y2="9" /></svg>
            </RequirementItem>
            <RequirementItem label="USB Drive" value="4 GB or larger for bootable media">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#54CD4C" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
            </RequirementItem>
          </div>
        </EditionCard>
      </section>

      <Footer />
    </div>
  </main>

  <script>
    import { trackDownload } from '../../lib/api';

    const btn = document.getElementById('download-btn') as HTMLButtonElement;
    btn?.addEventListener('click', async () => {
      const edition = btn.dataset.edition;
      const downloadUrl = btn.dataset.downloadUrl;

      if (!edition) return;

      btn.disabled = true;
      const span = btn.querySelector('span');
      const originalText = span?.textContent;
      if (span) span.textContent = 'Starting download...';

      try {
        await trackDownload(edition);
      } catch (error) {
        console.error('Failed to track download:', error);
      }

      btn.disabled = false;
      if (span && originalText) span.textContent = originalText;

      if (downloadUrl && downloadUrl !== '#') {
        window.location.href = downloadUrl;
      }
    });
  </script>
</Layout>
