---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/organisms/Navbar.astro';
import Footer from '../../components/organisms/Footer.astro';

const editions: Record<string, {
  name: string;
  codename: string;
  basedOn: string;
  kernelVersion: string;
  releaseDate: string;
  desktopEnvironment: string;
  size: string;
  downloadUrl: string;
  screenshot: string;
  displayServer: string;
  features: string[];
}> = {
  cosmic: {
    name: 'TeaLinux COSMIC',
    codename: 'Celia',
    basedOn: 'Arch Linux',
    kernelVersion: '6.25.2',
    releaseDate: '2025-06-14',
    desktopEnvironment: 'COSMIC',
    size: '~1.9 GiB',
    downloadUrl: 'https://pinguin.dinus.ac.id/iso/tealinuxos/TeaLinuxOS-Arch/2025/release/tealinux-celia-cosmic-2025.10.24-x86_64.iso',
    screenshot: '/src/assets/cosmic_de.webp',
    displayServer: 'Wayland',
    features: ['Wayland by default', 'Clean COSMIC desktop', 'Fast performance', 'Modern tiling support'],
  },
  plasma: {
    name: 'TeaLinux Plasma',
    codename: 'Celia',
    basedOn: 'Arch Linux',
    kernelVersion: '6.25.2',
    releaseDate: '2025-06-14',
    desktopEnvironment: 'KDE Plasma 6',
    size: '~2.0 GiB',
    downloadUrl: 'https://pinguin.dinus.ac.id/iso/tealinuxos/TeaLinuxOS-Arch/2025/release/tealinux-celia-plasma-2025.10.24-x86_64.iso',
    screenshot: '/src/assets/cosmic_de.webp',
    displayServer: 'X11 / Wayland',
    features: ['KDE Plasma 6', 'Full customization support', 'Beautiful, user-friendly interface', 'Extensive widget ecosystem'],
  },
};

export function getStaticPaths() {
  return [
    { params: { edition: 'cosmic' } },
    { params: { edition: 'plasma' } },
  ];
}

const { edition } = Astro.params;
const data = editions[edition!];

if (!data) {
  return Astro.redirect('/download');
}
---

<Layout title={`Download ${data.name} - TeaLinuxOS`}>
  <main class="min-h-screen bg-transparent text-slate-50 font-sans flow-root relative overflow-hidden">
    <div class="relative z-[1]">
      <Navbar />


      <!-- Edition Detail Section -->
      <section class="relative py-12 px-[5%] pt-40 max-w-[1100px] mx-auto">
        <div class="edition-detail-card">
          <div class="edition-layout">
            <!-- Screenshot Side -->
            <div class="edition-screenshot-wrapper">
              <div class="edition-screenshot-frame">
                <img 
                  src={data.screenshot} 
                  alt={`${data.name} Desktop`}
                  class="edition-screenshot"
                />
                <!-- Play button overlay -->
                <div class="screenshot-overlay">
                  <div class="play-button">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="white">
                      <polygon points="5 3 19 12 5 21 5 3"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>

            <!-- Info Side -->
            <div class="edition-info">
              <div class="edition-header">
                <h1 class="edition-title">
                  Resep Tea Linux
                  <span class="tea-icon">🍃</span>
                </h1>
                <span class="edition-badge">{data.displayServer}</span>
              </div>

              <div class="edition-specs">
                <div class="spec-row">
                  <span class="spec-label">Name</span>
                  <span class="spec-value">: {data.name}</span>
                </div>
                <div class="spec-row">
                  <span class="spec-label">Codename</span>
                  <span class="spec-value">: {data.codename}</span>
                </div>
                <div class="spec-row">
                  <span class="spec-label">Based On</span>
                  <span class="spec-value">: {data.basedOn}</span>
                </div>
                <div class="spec-row">
                  <span class="spec-label">Kernel Version</span>
                  <span class="spec-value">: {data.kernelVersion}</span>
                </div>
                <div class="spec-row">
                  <span class="spec-label">Release Date</span>
                  <span class="spec-value">: {data.releaseDate}</span>
                </div>
                <div class="spec-row">
                  <span class="spec-label">Desktop Environment</span>
                  <span class="spec-value">: {data.desktopEnvironment}</span>
                </div>
                <div class="spec-row">
                  <span class="spec-label">Size</span>
                  <span class="spec-value">: {data.size}</span>
                </div>
              </div>


            </div>
          </div>

          <!-- Separator -->
          <div class="edition-separator"></div>

          <!-- Download Button -->
          <div class="edition-download-section">
            <button 
              id="download-btn"
              data-edition={edition!.toUpperCase()} 
              data-download-url={data.downloadUrl}
              class="download-edition-btn group"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span>Direct Download</span>
            </button>
            <p class="download-note">
              File: tealinux-celia-{edition}-x86_64.iso • {data.size}
            </p>
          </div>
        </div>
      </section>

      <!-- System Requirements Section -->
      <section class="relative py-12 px-[5%] max-w-[1100px] mx-auto">
        <div class="requirements-card">
          <h2 class="text-xl font-bold text-white mb-6">System Requirements</h2>
          <div class="requirements-grid">
            <div class="requirement-item">
              <div class="req-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#54CD4C" stroke-width="2"><rect x="4" y="4" width="16" height="12" rx="2"/><line x1="2" y1="20" x2="22" y2="20"/></svg>
              </div>
              <div>
                <p class="req-label">Processor</p>
                <p class="req-value">x86_64 compatible (64-bit)</p>
              </div>
            </div>
            <div class="requirement-item">
              <div class="req-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#54CD4C" stroke-width="2"><path d="M6 19v-8a6 6 0 0112 0v8"/><rect x="4" y="19" width="16" height="2" rx="1"/></svg>
              </div>
              <div>
                <p class="req-label">RAM</p>
                <p class="req-value">Minimum 2 GB (4 GB recommended)</p>
              </div>
            </div>
            <div class="requirement-item">
              <div class="req-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#54CD4C" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
              </div>
              <div>
                <p class="req-label">Storage</p>
                <p class="req-value">Minimum 20 GB free disk space</p>
              </div>
            </div>
            <div class="requirement-item">
              <div class="req-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#54CD4C" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              </div>
              <div>
                <p class="req-label">USB Drive</p>
                <p class="req-value">4 GB or larger for bootable media</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <Footer />
    </div>
  </main>

  <script>
    import { trackDownload } from '../../lib/api';

    const btn = document.getElementById('download-btn') as HTMLButtonElement;
    btn?.addEventListener('click', async () => {
      const edition = btn.dataset.edition;
      const downloadUrl = btn.dataset.downloadUrl;

      if (!edition) return;

      btn.disabled = true;
      const span = btn.querySelector('span');
      const originalText = span?.textContent;
      if (span) span.textContent = 'Starting download...';

      try {
        await trackDownload(edition);
      } catch (error) {
        console.error('Failed to track download:', error);
      }

      btn.disabled = false;
      if (span && originalText) span.textContent = originalText;

      if (downloadUrl && downloadUrl !== '#') {
        window.location.href = downloadUrl;
      }
    });
  </script>
</Layout>

<style>
  /* Edition Detail Card */
  .edition-detail-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    backdrop-filter: blur(20px);
    overflow: hidden;
  }

  .edition-layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding: 2.5rem;
  }

  @media (min-width: 768px) {
    .edition-layout {
      flex-direction: row;
      gap: 3rem;
    }
  }

  /* Screenshot */
  .edition-screenshot-wrapper {
    flex: 1;
    min-width: 0;
  }

  .edition-screenshot-frame {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.1);
    background: #111;
    aspect-ratio: 16 / 10;
  }

  .edition-screenshot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .edition-screenshot-frame:hover .edition-screenshot {
    transform: scale(1.03);
  }

  .screenshot-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.3);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .edition-screenshot-frame:hover .screenshot-overlay {
    opacity: 1;
  }

  .play-button {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(84, 205, 76, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
    box-shadow: 0 0 30px rgba(84, 205, 76, 0.4);
    padding-left: 4px;
  }

  /* Info Section */
  .edition-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .edition-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .edition-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: #54CD4C;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
  }

  .tea-icon {
    font-size: 1.5rem;
  }

  .edition-badge {
    display: inline-block;
    width: fit-content;
    padding: 4px 14px;
    border-radius: 999px;
    background: rgba(84, 205, 76, 0.15);
    color: #54CD4C;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    border: 1px solid rgba(84, 205, 76, 0.3);
  }

  /* Specs Table */
  .edition-specs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .spec-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .spec-label {
    color: #54CD4C;
    font-weight: 600;
    min-width: 150px;
    flex-shrink: 0;
  }

  .spec-value {
    color: #e2e8f0;
  }

  @media (max-width: 640px) {
    .spec-label {
      min-width: 120px;
      font-size: 0.8125rem;
    }
    .spec-value {
      font-size: 0.8125rem;
    }
  }

  /* Features */
  .edition-features {
    padding-top: 0.5rem;
  }

  .features-title {
    font-size: 0.8125rem;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.75rem 0;
  }

  .features-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.8125rem;
    color: #cbd5e1;
  }

  /* Separator */
  .edition-separator {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1) 20%, rgba(255,255,255,0.1) 80%, transparent);
    margin: 0 2.5rem;
  }

  /* Download Section */
  .edition-download-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 2.5rem 2.5rem;
  }

  .download-edition-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.875rem 2.5rem;
    min-width: 240px;
    border-radius: 999px;
    background: #54CD4C;
    color: #000;
    font-size: 0.9375rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .download-edition-btn:hover {
    background: #45b83f;
    box-shadow: 0 0 30px rgba(84, 205, 76, 0.4);
    transform: translateY(-1px);
  }

  .download-edition-btn:active {
    transform: translateY(0);
  }

  .download-edition-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .download-note {
    font-size: 0.75rem;
    color: #64748b;
    margin: 0;
  }

  /* Requirements Card */
  .requirements-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2rem;
  }

  .requirements-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .requirements-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .requirement-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .req-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(84, 205, 76, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .req-label {
    font-size: 0.75rem;
    color: #64748b;
    margin: 0 0 0.25rem 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .req-value {
    font-size: 0.875rem;
    color: #e2e8f0;
    margin: 0;
  }
</style>
