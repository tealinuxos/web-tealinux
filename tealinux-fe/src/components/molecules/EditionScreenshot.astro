---
interface Props {
	screenshot: string;
	name: string;
}

const { screenshot, name } = Astro.props;
---

<div class="flex-1 min-w-0">
	<div class="relative rounded-[14px] overflow-hidden border-2 border-white/10 bg-[#111] aspect-[16/10] group/ss">
		<img
			src={screenshot}
			alt={`${name} Desktop`}
			class="w-full h-full object-cover"
		/>
	</div>
</div>
