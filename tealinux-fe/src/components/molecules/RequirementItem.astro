---
interface Props {
	label: string;
	value: string;
}

const { label, value } = Astro.props;
---

<div class="flex items-start gap-4 p-4 rounded-xl bg-white/[0.02] border border-white/[0.05]">
	<div class="w-10 h-10 rounded-[10px] bg-[#54CD4C]/10 flex items-center justify-center shrink-0">
		<slot />
	</div>
	<div>
		<p class="text-xs text-slate-500 mb-1 uppercase tracking-wider font-semibold m-0">{label}</p>
		<p class="text-sm text-slate-200 m-0">{value}</p>
	</div>
</div>
