---
interface Props {
	label: string;
	value: string;
}

const { label, value } = Astro.props;
---

<div class="flex items-baseline gap-2 text-sm leading-relaxed">
	<span class="text-[#54CD4C] font-semibold min-w-[150px] shrink-0 max-sm:min-w-[120px] max-sm:text-[13px]">{label}</span>
	<span class="text-slate-200 max-sm:text-[13px]">: {value}</span>
</div>
